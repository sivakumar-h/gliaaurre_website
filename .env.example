# Email delivery (choose one provider — used in src/lib/email.ts)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Sender address for outgoing emails (must be on a Resend-verified domain)
FROM_EMAIL=

# Recipients for job application emails (careers page).
# Supports multiple addresses separated by commas — all listed addresses receive every application.
OWNER_EMAIL=hr1@gliaaurre.com,divyam@gliaaurre.com,isha@gliaaurre.com

# Recipients for contact form inquiries.
# Supports multiple addresses separated by commas — all listed addresses receive every inquiry.
CONTACT_RECEIVER_EMAIL=hr1@gliaaurre.com,divyam@gliaaurre.com,isha@gliaaurre.com
